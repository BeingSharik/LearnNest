# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Supabase Public Configuration (safe for browser ONLY with RLS)
# Replace placeholders in .env.local or deployment environment vars.
# ------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# ------------------------------------------------------------------
# Supabase Server Configuration (Express / Server-Side Only)
# NEVER prefix SUPABASE_SECRET_KEY with VITE_ or NEXT_PUBLIC_
# ------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------
# Transactional Email (Resend — Server-Side Only)
# NEVER prefix RESEND_API_KEY with VITE_ or NEXT_PUBLIC_
# ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="LearnNest <onboarding@resend.dev>"

# ------------------------------------------------------------------
# Admin Portal Credentials (Server-Side Only — NEVER prefix VITE_)
# ------------------------------------------------------------------
ADMIN_PORTAL_USERNAME=
ADMIN_PORTAL_PASSWORD=
